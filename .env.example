# ==============================================================================
# Litecoin Node — Material 3 Glass Suite Configuration
# Copy this file to .env and adjust passwords before starting in production!
# ==============================================================================

# --- Litecoin Core Image & Network ---
LITECOIN_VERSION=0.21
LITECOIN_P2P_PORT=9333
LITECOIN_DATA_DIR=./data/litecoin

# --- Internal RPC Credentials (RPC port stays internal on Docker network) ---
RPC_USER=litecoin
RPC_PASSWORD=CHANGE_ME_STRONG_RPC_PASSWORD

# --- Node Tuning ---
# DB cache in MB (recommended: 1024-4096 during IBD if RAM allows)
DB_CACHE=1024
MAX_CONNECTIONS=125
MAX_MEMPOOL=300
# Set PRUNE_MB=0 for full archival node (txindex=1 + blockfilterindex=1),
# or e.g. PRUNE_MB=10000 (~10 GB) for pruned storage mode.
PRUNE_MB=0

# --- Privacy / Tor / SOCKS5 Proxy (Optional) ---
# Leave empty for direct clearnet P2P.
# With Tor profile (`docker compose --profile tor up -d`), set: SOCKS5_PROXY=tor:9050
# Or point to an external proxy/VPN container (e.g. gluetun/socks5): host:port
SOCKS5_PROXY=
# Set true to route P2P exclusively over .onion when Tor is enabled
ONLYNET_ONION=false

# --- Dashboard & Security ---
DASHBOARD_PORT=8080
# Password protecting RPC Terminal, Peer Ban/Disconnect/Add & Raw TX Broadcast
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Set true to require login before viewing ANY part of the dashboard
LOCK_ENTIRE_DASHBOARD=false
